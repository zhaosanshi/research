+def backward_by_kind(bundle, layer, rows, kinds, w, *, loss="jsd", positions="content"):
+    """Gradient of question_loss with the cause rows and the isolate rows back-propagated one after the other.
 
+    question_loss is the mean over the cause rows plus the mean over the isolate rows. The gradient of a sum is the sum
+    of the gradients, so each part is run forward and backward on its own and the two gradients add up in w.grad; only
+    one part's rows are held with their activations at a time (a write layer close to the input otherwise needs more
+    memory than one card has). Returns (per_row [B] detached, in the order of `rows`; value detached): the quantities
+    the single pass computes.
+    """
+    if len(kinds) != len(rows) or any(k not in ("cause", "isolate") for k in kinds):
+        raise ValueError('each loss row needs an explicit cause/isolate kind')
+    if "cause" not in kinds:
+        raise ValueError("a training question needs at least one cause row")
+    per_row = None
+    value = None
+    for kind in ("cause", "isolate"):
+        index = [i for i, k in enumerate(kinds) if k == kind]
+        if not index:
+            continue
+        part, _ = rows_loss(bundle, layer, [rows[i] for i in index], w=w, loss=loss, positions=positions, grad=True)
+        term = part.mean()
+        if not torch.isfinite(term):
+            raise RuntimeError("nonfinite training loss at layer %d" % layer)
+        term.backward()
+        if per_row is None:
+            per_row = part.detach().new_zeros(len(rows))
+        per_row[index] = part.detach()
+        value = term.detach() if value is None else value + term.detach()
+        del part, term
+    return per_row, value
+
+
