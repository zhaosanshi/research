@@ -0,0 +1,60 @@
+"""Validate prompt-factor acceptance before either launcher consumes cached outputs. CPU only."""
+import hashlib
+import json
+import math
+from pathlib import Path
+import sys
+
+
+def digest(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+LEGACY = {
+    'qwen3.8-27b': '6591be9854abdf3786833bb03e64b91222c26d82b04144596299f3873cf4830b',
+    'qwen3.5-9b': '33f1dab44e08bab192385c3483e973037655d945400adedc465fa4b7a4613ac0',
+    'llama3.1-8b': 'e8ed32ccaf9584ea86870545298acf854932df75992f11459477c8d7af9de9da',
+    'gemma3-27b': 'c03b665506a18887f5a1b26a4bb48ded2b9bb0e6ec4fcd61114bd8808422a66f',
+    'gemma3-12b': 'fed96cded9dfde1ff4c11db37de13a801861031315e47a7a8d694bcfadff93f7',
+    # The original five reports preceded the h22 zero-cell extension to ns_h22.py.
+}
+
+
+def validate(path, expected_model, expected_arm, producer, tune, bank, prompt, promptdiag=False):
+    report = json.loads(path.read_bytes())
+    if (report.get("passed") is not True or report.get("model") != expected_model or report.get("arm") != expected_arm
+            or (report.get("entry_sha256") != digest(producer) and digest(path) != LEGACY.get(expected_model))):
+        raise ValueError("acceptance failed or belongs to another model, arm or program")
+    tune_ids = json.loads(tune.read_bytes())["question_ids"][:16]
+    if len(set(tune_ids)) != 16:
+        raise ValueError("expected 16 distinct tune IDs")
+    if producer.name == "n1s_check.py":
+        if report["ids"] != tune_ids or any(report[k] != 16 for k in ("E0_equals_no_write", "E0_equals_saved_P", "E_twice", "EC_twice")):
+            raise ValueError("wrong stack acceptance roster or check result")
+        if [w["family"] for w in report["writes"]] != ["E", "C"]:
+            raise ValueError("wrong stack directions")
+        for key in ("E_token_ids","EC_token_ids"):
+            if len(report[key]) != 16:
+                raise ValueError("missing repeatability reference")
+        writes = report["writes"]
+    else:
+        if report["positions"] != "prompt" or report["prompts_sha256"] != digest(prompt):
+            raise ValueError("wrong prompt or intervention position")
+        with bank.open(encoding="utf-8") as f:
+            bank_ids = [json.loads(next(f))["id"] for _ in range(16)]
+        if len(set(bank_ids)) != 16:
+            raise ValueError("expected 16 distinct bank IDs")
+        for k, ids in (("truthfulqa_tune", tune_ids), ("bank", bank_ids)):
+            check = report["checks"][k]
+            if check["ids"] != ids or check["zero_equals_no_write"] != 16 or check["twice_identical"] != 16:
+                raise ValueError("wrong prompt acceptance roster or check result")
+        if promptdiag and any(report["checks"]["truthfulqa_tune"].get(k) != 16 for k in ("promptdiag_equals_zero","promptdiag_equals_no_write")):
+            raise ValueError("missing promptdiag agreement")
+        writes = [report["write"]]
+    if any(not math.isfinite(w["amount"]) or w["amount"] == 0 or not w["direction_file_sha256"] for w in writes):
+        raise ValueError("invalid nonzero write")
+
+
+if __name__ == "__main__":
+    report, model, arm, producer, tune, bank, prompt, promptdiag = sys.argv[1:]
+    validate(Path(report), model, arm, Path(producer), Path(tune), Path(bank), Path(prompt), promptdiag == "yes")
