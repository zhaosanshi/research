+def read_single(model, source):
+    doc, meta, z = SP.read_probe(model, source=source)
+    if meta.get("batch_size") != 1 or meta.get("path_identity_batch8_first") != 64:
+        raise ValueError(f"{model} {source}: score is not a verified singleton pass")
+    return doc, meta, z
+
+
+def repeat_check(model, source, *, test_only):
+    """Check identity, split, ordering and margins against the main scored statements."""
+    import numpy as np
+    main, _, data = read_single(model, source + "_items")
+    issued = [x for x in main["items"] if x["answered"]]
+    positions = [i for i, x in enumerate(issued) if not test_only or x["split"] == "test"]
+    if len(positions) < 16:
+        raise ValueError(f"{model} {source}: fewer than 16 eligible checks")
+    selected = sorted(np.random.default_rng(20261122).choice(len(positions), 16, replace=False).tolist())
+    chosen = [positions[j] for j in selected]
+    order = np.random.default_rng(20261123).permutation(16)
+    for suffix, idx in (("_chk", chosen), ("_chka", chosen), ("_chkb", [chosen[j] for j in order])):
+        doc, _, z = read_single(model, source + suffix)
+        if doc["items"] != [issued[i] for i in idx]:
+            raise ValueError(f"{model} {source}{suffix}: wrong repeat rows or order")
+        for c in SP.conds_of(model, "x"):
+            if not np.array_equal(z[c + "__margin"], data[c + "__margin"][idx]):
+                raise ValueError(f"{model} {source}{suffix}: repeat differs from main score")
+    return True, f"check (b) {model}: 16 main scores, both repeats and shuffle matched"
+
